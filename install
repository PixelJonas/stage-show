#!/bin/sh
# Installs the skill's tools and venv with mise (mise.toml, requirements.txt), from any folder: <skill>/install
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
chmod +x "$dir/run" "$dir/install" 2>/dev/null
mise=$(command -v mise 2>/dev/null) || for mise in "$HOME/.local/bin/mise" /opt/homebrew/bin/mise /usr/local/bin/mise; do [ -x "$mise" ] && break; done
if [ ! -x "$mise" ]; then
  echo "stage-show: mise not found: install it (https://mise.jdx.dev), or the tools by hand ($dir/README.md, Install)" >&2
  exit 1
fi
# mise reads no config from the folders above the skill: a copy inside a project leaves that project's config alone
export MISE_CEILING_PATHS="$(dirname -- "$dir")"
cd "$dir" && "$mise" trust "$dir/mise.toml" && "$mise" install && "$mise" run setup
